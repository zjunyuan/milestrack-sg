// MilesTrack SG - Firestore security rules (v1.62.1)
// Paste into: Firebase console > Firestore Database > Rules > Publish.
// Role email lists are in Firestore (milestrack_config/roles), not in this file or in js/config.js.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email; }

    // Who is on which list lives in the document milestrack_config/roles (arrays of lowercase emails: primary, sister, member1, member2, test; plus a `labels` map of display names the rules ignore),
    // so no email address is in this public repo. Create that document BEFORE publishing these rules or everyone is locked out.
    function roles() { return get(/databases/$(database)/documents/milestrack_config/roles).data; }
    function isPrimary() { return signedIn() && email() in roles().primary; }
    function isSister()  { return signedIn() && email() in roles().sister; }
    function isMember1() { return signedIn() && email() in roles().member1; }
    function isMember2() { return signedIn() && email() in roles().member2; }
    function isTest()    { return signedIn() && email() in roles().test; }
    function isMember()  { return isPrimary() || isSister() || isMember1() || isMember2() || isTest(); }

    // Can this user read/write data belonging to vault `key`?
    function canAccess(key) {
      return (isPrimary() && key in ['household', 'primary'])
          || (isSister() && key == 'sister')
          || (isMember1() && key == 'member1')
          || (isMember2() && key == 'member2')
          || (isTest()   && key == 'test');
    }

    // The role lists. Only a listed member can read them; nobody can write them from the app (edit them in the Firebase console).
    match /milestrack_config/{docId} {
      allow read: if isMember();
      allow write: if false;
    }

    match /milestrack_vaults/{vaultId} {
      allow read: if isPrimary() || canAccess(vaultId);   // household admin reads every vault for the tally
      allow write: if canAccess(vaultId);
    }

    match /milestrack_txns/{txnId} {
      allow read:   if isPrimary() || canAccess(resource.data.owner);
      allow create: if canAccess(request.resource.data.owner);
      allow update: if canAccess(resource.data.owner) && canAccess(request.resource.data.owner);
      allow delete: if isPrimary() || canAccess(resource.data.owner);
    }

    // Settings docs are keyed by vault ID (the app uses myVaultKey)
    match /milestrack_settings/{docId} {
      allow read, write: if canAccess(docId);
    }

    // What the banks say about points (v1.59.0): statement points summaries, typed balances, transfers and redemptions.
    // Same ownership as transactions: one record per vault owner.
    match /milestrack_points/{recId} {
      allow read:   if isPrimary() || canAccess(resource.data.owner);
      allow create: if canAccess(request.resource.data.owner);
      allow update: if canAccess(resource.data.owner) && canAccess(request.resource.data.owner);
      allow delete: if canAccess(resource.data.owner);
    }

    // Household-shared retailer -> MCC corrections (v1.10.0).
    // Any household member can read and fix them; shape is validated.
    match /milestrack_merchants/{slug} {
      allow read: if isMember();
      allow create, update: if isMember()
        && slug.matches('^[a-z0-9-]{1,60}$')
        && request.resource.data.keys().hasOnly(['name', 'mcc', 'aliases', 'updatedBy', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.mcc is string && request.resource.data.mcc.size() == 4
        && (!('aliases' in request.resource.data)
            || (request.resource.data.aliases is list && request.resource.data.aliases.size() <= 10));
      allow delete: if isMember();
    }

    // Household card rules per MCC category (v1.12.0).
    // Every member reads them; only the household admin (primary) writes.
    match /milestrack_mccRules/{code} {
      allow read: if isMember();
      allow create, update: if isPrimary()
        && code.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['mcc', 'local', 'overseas', 'note', 'expires', 'updatedBy', 'updatedAt'])
        && request.resource.data.mcc == code
        && request.resource.data.local is list && request.resource.data.local.size() <= 20
        && request.resource.data.overseas is list && request.resource.data.overseas.size() <= 20
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.expires is string
        && (request.resource.data.expires.size() == 0 || request.resource.data.expires.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      allow delete: if isPrimary();
    }
  }
}
